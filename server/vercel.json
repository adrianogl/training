{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/v1/:route*",
      "destination": "/api/router?route=:route*"
    },
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/v1/cron/garmin-sync",
      "schedule": "0 12 * * *"
    }
  ]
}
