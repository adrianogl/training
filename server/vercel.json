{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/v1/:route*",
      "destination": "/api/router?route=:route*"
    },
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ],
  "buildCommand": "npm run build"
}
