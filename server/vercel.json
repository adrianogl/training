{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/api/v1/:route*",
      "destination": "/api/router?route=:route*"
    },
    {
      "source": "/(convite|convites|confirmar|redefinir-senha)",
      "destination": "/link.html"
    },
    {
      "source": "/app/(convite|confirmar|redefinir-senha)",
      "destination": "/link.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build"
}
