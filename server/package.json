{
  "name": "training-sync-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate": "node --experimental-strip-types scripts/migrate.ts",
    "email:preview": "vitest run --config vitest.preview.config.ts",
    "test:concurrency": "SYNC_TEST_POSTGRES_IMAGE=postgres:17-alpine vitest run",
    "build": "npm run migrate && rm -rf public && mkdir -p public && cp -R landing/. public/ && npm --prefix web ci && npm --prefix web run build"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.218.0",
    "@neondatabase/serverless": "1.2.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "22.20.4",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
